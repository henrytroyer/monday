# Copy to .env and adjust. NEVER commit .env — it contains secrets.
# Run: npm run setup

# =============================================================================
# DEFAULT: Mock mode (works immediately after clone, no token needed)
# =============================================================================
VITE_USE_MOCK_DATA=true

# =============================================================================
# LIVE monday.com (uncomment block below + add MONDAY_API_TOKEN)
# Requires: npm run dev:live  →  http://localhost:4040
# Each developer creates their own token at monday.com → Developers → API
# =============================================================================
# VITE_USE_MOCK_DATA=false
# VITE_MONDAY_READ_ONLY=true
# VITE_CONTACTS_WRITABLE=true
# VITE_APPLICATION_NOTES_WRITABLE=true
# VITE_APPLICATIONS_WRITABLE=true
# VITE_LONGTERM_REFERENCES_WRITABLE=true
# VITE_DONATIONS_WRITABLE=true
# VITE_SAFEGUARDING_WRITABLE=true
# VITE_CRM_ROLE=admin
# VITE_CONTACTS_BOARD_ID=2463183745
# VITE_APPLICATIONS_BOARD_ID=2473000031
# VITE_LONGTERM_APPLICATIONS_BOARD_ID=2927925742
# VITE_DONATIONS_BOARD_ID=2473175689
# VITE_MONDAY_API_PROXY_URL=/api/monday
# Monday proxy uses API version 2025-01 (required for Emails & Activities timeline)
# VITE_MONDAY_WATCH_ENABLED=true
# VITE_MONDAY_WATCH_INTERVAL_MS=60000
# Note review approve/dismiss sync (auto-created on Contacts board when writable)
# VITE_CRM_NOTE_REVIEW_REGISTRY_ITEM_ID=
# Only queue board updates from the last N days (default 30) — avoids full history backfill
# VITE_NOTE_HARVEST_LOOKBACK_DAYS=30
# MONDAY_API_TOKEN=

# Applications column overrides (match your board titles — see docs/crm-column-mapping.md)
# VITE_COL_LOCATION_PREFERENCE=i58 Location Preference
# VITE_COL_LOCATION=Location
# VITE_COL_STATUS=Status ↗️
# VITE_COL_SIGNUP_TIMELINE=Preferred Dates
# VITE_COL_NOTES=Notes
# VITE_COL_EMAIL=Email Address
# VITE_COL_PARENT_EMAIL=Parent's Email
# VITE_COL_PASTOR_EMAIL=Pastor's Email
# VITE_COL_PHONE=Applicant Phone
# VITE_COL_MARITAL_STATUS=Marital Status
# VITE_COL_PRIMARY_FIRST_NAME=First Name Only
# VITE_COL_SPOUSE_NAME=Spouse Name
# VITE_COL_SPOUSE_EMAIL=Spouse Email
# VITE_COL_SPOUSE_PHONE=Spouse Phone
# VITE_COL_SPOUSE_BIRTHDAY=Spouse Birthday
# VITE_COL_SPOUSE_GENDER=Spouse Gender
# VITE_COL_SPOUSE_PROFILE_PHOTO=Spouse Profile Pic
# VITE_COL_SPOUSE_PASSPORT=Spouse Passport Photo
# VITE_COL_ARRIVAL_DEPARTURE_TIMELINE=Arrival/Departure Date
# VITE_COL_PREFERRED_ITINERARY_AIRPORT=Preferred nearby airport for international departure/arrival

# Long-term applications board (Volunteer Service - Long Term)
# VITE_LONGTERM_APPLICATIONS_BOARD_ID=2927925742
# VITE_LONGTERM_COL_STATUS=Status
# VITE_LONGTERM_COL_EMAIL=Your Email
# VITE_LONGTERM_COL_PHONE=Your Phone Number
# VITE_LONGTERM_COL_LOCATION=Location
# VITE_LONGTERM_COL_TERM_RANGE=Length of Term
# VITE_LONGTERM_COL_SIGNUP_TIMELINE=Preferred start month

# Contacts column link IDs
# VITE_CONTACT_COL_PASTOR_REFERENCE_LINK_ID=link_to_pastors_reference7
# Optional: dedicated pastor reference form board (auto-discovered from Contact link when unset)
# VITE_PASTOR_REFERENCE_BOARD_ID=
# VITE_CONTACT_COL_DONATIONS_LINK_ID=link_to_donations
# VITE_CONTACT_COL_SERVICE_ENDED_LINK_ID=board_relation0

# Current Service Ended board (past volunteer terms on contact detail)
# VITE_SERVICE_ENDED_BOARD_ID=5882671161
# VITE_CONTACT_COL_SERVICE_ENDED_LINK=link to Current Service Ended
# VITE_CONTACT_COL_APPLICATIONS=Volunteer Service - Short Term

# End of Service Review board (Volunteer Feedback Form by default)
# VITE_EOS_REVIEW_BOARD_ID=4399458542
# VITE_EOS_REVIEW_COL_CONTACT_LINK=Contacts
# VITE_EOS_REVIEW_COL_CONTACT_LINK_ID=connect_boards4
# VITE_EOS_REVIEW_COL_EMAIL=Email
# Optional explicit completion date column (e.g. VS Exit Survey: Date Volunteer left)
# VITE_EOS_REVIEW_COL_COMPLETED_DATE=Date Volunteer left

# Optional comma-separated board IDs to harvest/watch
# VITE_MONDAY_BOARD_IDS=2463183745,2473000031

# Contacts board name (display only)
# VITE_CONTACTS_BOARD_NAME=Contacts

# Contacts column overrides — see docs/crm-contacts.md
# VITE_CONTACT_COL_TAGS=Tags
# VITE_CONTACT_COL_EMAIL=Email
# VITE_CONTACT_COL_PROFILE_PHOTO=Profile Photo
# VITE_CONTACT_COL_QBO_CUSTOMER_ID=QuickBooks Customer ID
# VITE_CONTACT_COL_APPLICATIONS=Applications
# VITE_CONTACT_COL_ADDRESS=Address
# VITE_CONTACT_COL_CITY=City
# VITE_CONTACT_COL_COUNTRY=Country
# VITE_CONTACT_COL_DATE_OF_BIRTH=Date of birth

# Donations board columns
# VITE_DONATION_COL_EMAIL=Donor Email
# VITE_DONATION_COL_DATE=Date
# VITE_DONATION_COL_AMOUNT=Amount
# VITE_DONATION_COL_PROGRAM=Program
# VITE_DONATION_COL_DESIGNATION=Designation

# Long-term applications board (Volunteer Service - Long Term)
# VITE_LONGTERM_APPLICATIONS_BOARD_ID=2927925742
# VITE_LONGTERM_REFERENCES_BOARD_ID=4510144248
# VITE_LT_EMPLOYER_REFERENCE_BOARD_ID=18414703692
# Allow reference sent/review writes while read-only
# VITE_LONGTERM_REFERENCES_WRITABLE=true

# Email Templates board (import from Communications docs folder)
# VITE_EMAIL_TEMPLATES_BOARD_ID=
# VITE_EMAIL_TEMPLATES_BOARD_NAME=Email Templates
# VITE_EMAIL_TEMPLATES_WRITABLE=true
# VITE_EMAIL_TEMPLATE_COL_SUBJECT=Subject
# VITE_EMAIL_TEMPLATE_COL_BODY=Body
# VITE_EMAIL_TEMPLATE_COL_TEMPLATE_ID=Template ID
# VITE_COMMUNICATIONS_DOCS_FOLDER_NAME=Volunteer Communications Templates

# CRM Email Threads / Messages index boards (npm run seed:email-thread-boards)
# VITE_EMAIL_THREADS_BOARD_ID=
# VITE_EMAIL_MESSAGES_BOARD_ID=

# Portal Things board — CRM infrastructure (onboarding / recruitment / signatures)
# Create with: npm run seed:portal-things
# VITE_PORTAL_THINGS_BOARD_ID=
# VITE_PORTAL_THINGS_BOARD_NAME=Portal Things
# VITE_PORTAL_THINGS_WRITABLE=true
# VITE_PORTAL_COL_KIND=Kind
# VITE_PORTAL_COL_ENTITY_ID=Entity ID
# VITE_PORTAL_COL_PAYLOAD_JSON=Payload JSON

# CRM outbound email (monday-api-proxy /email/send) — pick ONE provider
# From address should be an i58global mailbox (e.g. info@i58global.org)
# EMAIL_FROM_ADDRESS=info@i58global.org
# EMAIL_FROM_NAME=i58 Global
# Option A — Resend (https://resend.com): verify i58global.org domain
# RESEND_API_KEY=
# Option B — Gmail / Google Workspace SMTP (app password for the mailbox)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@i58global.org
# SMTP_PASS=

# VITE_SAFEGUARDING_BOARD_ID=6616292638
# VITE_SAFEGUARDING_COL_EMAIL=Email
# VITE_SAFEGUARDING_COL_CERTIFICATE=Upload Certificate Here
# VITE_SAFEGUARDING_COL_DATE=Date

# QuickBooks (optional) — run npm run quickbooks:proxy
# VITE_QUICKBOOKS_PROXY_URL=/api/quickbooks
# VITE_COL_QUICKBOOKS_INVOICE_ID=QuickBooks Invoice ID

# Server-side only — never expose in VITE_ variables
# QBO_ACCESS_TOKEN=
# QBO_REALM_ID=

# Mailchimp sync (npm run sync:contacts)
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=
# MAILCHIMP_DATACENTER=us1
# MONDAY_BOARD_NAME=Contacts
