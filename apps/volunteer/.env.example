# Public i58-finance Firebase web config (same project as the finance app).
# Copy the web API key from Firebase console → Project settings → Your apps.
# Do not commit the key. It is not the Monday token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=i58-finance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=i58-finance
VITE_FIREBASE_STORAGE_BUCKET=i58-finance.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=46554564816
VITE_FIREBASE_APP_ID=1:46554564816:web:a518311ee91b25d5d4b6d5

# Leave empty in local dev to use the Vite proxy (/api/volunteer-identity -> :4051).
# Production Cloud Function (after it is deployed from i58finance):
# VITE_VOLUNTEER_IDENTITY_URL=https://europe-west3-i58-finance.cloudfunctions.net/volunteerIdentity
VITE_VOLUNTEER_IDENTITY_URL=
